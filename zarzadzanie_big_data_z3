# ==========================================
### 5 — Detekcja outlierów
# ==========================================
print("\n--- Część 5: Detekcja outlierów ---")
def outliers_iqr(s, k=1.5):
    Q1, Q3 = s.quantile(0.25), s.quantile(0.75)
    return (s < Q1 - k * (Q3 - Q1)) | (s > Q3 + k * (Q3 - Q1))

out_iqr = outliers_iqr(df["cena_pln"]).sum()

out_z = (np.abs(stats.zscore(df["cena_pln"])) > 3).sum()

def mod_z(s):
    med = s.median()
    mad = (s - med).abs().median()
    return 0.6745 * (s - med) / mad

out_mod_z = (np.abs(mod_z(df["cena_pln"])) > 3.5).sum()

print(f"Liczba outlierów dla 'cena_pln': IQR (1.5x) = {out_iqr}, Z-score (|z|>3) = {out_z}, Modified Z-score (|z_mod|>3.5) = {out_mod_z}")

metraz_outliers_idx = outliers_iqr(df["metraz_m2"])
print("\nTop 5 największych outlierów dla metraz_m2:")
print(df.loc[metraz_outliers_idx, ["id_oferty", "dzielnica", "metraz_m2"]].sort_values("metraz_m2", ascending=False).head(5))

bad_years = df[(df["rok_budowy"] < 1900) | (df["rok_budowy"] > 2026)]
print("\nWiersze z nielogicznym rokiem budowy:")
print(bad_years[["id_oferty", "rok_budowy"]])


# ==========================================
### 6 — Decyzja i czyszczenie
# ==========================================
print("\n--- Część 6: Decyzja i czyszczenie ---")
df_clean = df[~((df["rok_budowy"] < 1900) | (df["rok_budowy"] > 2026))].copy()
print(f"Liczba wierszy po usunięciu błędnych dat: {len(df_clean)}")

cap_low = df_clean["cena_pln"].quantile(0.01)
cap_high = df_clean["cena_pln"].quantile(0.99)
df_clean["cena_pln_capped"] = df_clean["cena_pln"].clip(lower=cap_low, upper=cap_high)

df_clean["cena_pln_log"] = np.log1p(df_clean["cena_pln"])

print(f"Skewness przed transformacją log: {df_clean['cena_pln'].skew():.2f}")
print(f"Skewness po transformacji log: {df_clean['cena_pln_log'].skew():.2f}")

fig, axes = plt.subplots(1, 2, figsize=(12, 4))
sns.histplot(df_clean["cena_pln"], ax=axes[0], bins=30)
axes[0].set_title(f"Cena przed (skew: {df_clean['cena_pln'].skew():.2f})")
sns.histplot(df_clean["cena_pln_log"], ax=axes[1], bins=30)
axes[1].set_title(f"Cena po log1p (skew: {df_clean['cena_pln_log'].skew():.2f})")
plt.tight_layout()
plt.show()


