print(f"Cena - średnia: {cena_mean:.2f}, mediana: {cena_median:.2f}, std: {cena_std:.2f}, skewness: {cena_skew:.2f}, kurtosis: {cena_kurt:.2f}")

metraz_q1 = df["metraz_m2"].quantile(0.25)
metraz_q3 = df["metraz_m2"].quantile(0.75)
metraz_iqr = metraz_q3 - metraz_q1
